{
  "name": "sweep-external-sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Sweep External API: signed backend client, webhook verification and browser wallet execution helpers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TinyTimur/sweep-external-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "require": "./dist/browser/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "sweep",
    "cross-chain",
    "intents",
    "bridge",
    "evm",
    "eip-1193",
    "eip-5792"
  ],
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
